# Placeholder-only local configuration. Copy to .env and replace locally; never commit .env.
HY3_ENDPOINT_URL=https://YOUR_HY3_ENDPOINT
HY3_API_KEY=YOUR_HY3_API_KEY

# Local artifact/catalog defaults.
HY3_ARTIFACT_ROOT=artifacts/runs
HY3_CATALOG_ROOT=data/problems
HY3_HOST=127.0.0.1
HY3_PORT=8000
HY3_BACKGROUND_WORKERS=2

# Required only after the corresponding Task 5/Task 6 integration is present.
HY3_API_APP_MODULE=YOUR_TASK5_APP_FACTORY
HY3_STREAMLIT_APP_PATH=YOUR_TASK6_STREAMLIT_APP_PATH
HY3_API_PORT=8000
HY3_UI_PORT=8501
