# Placeholders only. Copy to a local ignored .env; never commit a real value.
# The API process consumes exactly HY3_BASE_URL, HY3_API_KEY, and HY3_MODEL.
HY3_BASE_URL=https://YOUR_AUTHORISED_HY3_ENDPOINT
HY3_API_KEY=YOUR_HY3_API_KEY
HY3_MODEL=YOUR_HY3_MODEL

# Local composition inputs. Every image reference must be repository@sha256:... .
# A real runtime build is blocked until its image identity and complete closure replace the
# checked-in release-blocker sentinel in docker/release-runtime-lock.json.
HY3_APP_RUNTIME_IMAGE=YOUR_LOCKED_PYTHON_RUNTIME_IMAGE_AT_SHA256
# The attested runtime image already contains this Docker CLI; app builds never run apt.
HY3_DOCKER_CLI_PACKAGE=docker.io=YOUR_ATTESTED_DOCKER_CLI_PACKAGE_VERSION
HY3_JUDGE_IMAGE=YOUR_JUDGE_IMAGE_AT_SHA256
HY3_CATALOG_ROOT_HOST=/ABSOLUTE/PATH/TO/VERIFIED/FORMAL/CATALOG
HY3_DOCKER_SOCKET_PATH=/var/run/docker.sock
HY3_ARTIFACT_ROOT=artifacts/runs
HY3_BACKGROUND_WORKERS=2
HY3_CODE_REVISION=unknown
HY3_API_PORT=8000
HY3_UI_PORT=8501
